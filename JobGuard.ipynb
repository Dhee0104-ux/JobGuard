def create_confusion_matrix():

    if TEST_DATA is None:

        return None

    cm = confusion_matrix(
        TEST_DATA["actual"],
        TEST_DATA["predicted"]
    )

    fig = px.imshow(
        cm,
        text_auto=True,
        x=["Legitimate", "Scam"],
        y=["Legitimate", "Scam"],
        labels={
            "x": "Predicted",
            "y": "Actual",
            "color": "Count"
        },
        title="JobGuard Confusion Matrix"
    )

    return fig

