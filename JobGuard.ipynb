def train_uploaded_dataset(file):

    if file is None:

        return (
            "⚠️ No file uploaded. The demo model is still active.",
            None,
            None
        )

    try:

        filename = file.name.lower()

        if filename.endswith(".csv"):

            df = pd.read_csv(file.name)

        elif filename.endswith(".xlsx"):

            df = pd.read_excel(file.name)

        else:

            return (
                "❌ Please upload a CSV or Excel file.",
                None,
                None
            )

        metrics = train_jobguard(df)

        result = (
            f"✅ Successfully trained JobGuard on "
            f"{len(DATASET):,} job postings.\n\n"
            f"Accuracy: {metrics['Accuracy'] * 100:.2f}%\n"
            f"Precision: {metrics['Precision'] * 100:.2f}%\n"
            f"Recall: {metrics['Recall'] * 100:.2f}%\n"
            f"F1 Score: {metrics['F1 Score'] * 100:.2f}%\n"
            f"ROC AUC: {metrics['ROC AUC'] * 100:.2f}%"
        )

        cm_fig = create_confusion_matrix()

        metrics_df = pd.DataFrame({
            "Metric": list(metrics.keys()),
            "Score": [
                round(v * 100, 2)
                for v in metrics.values()
            ]
        })

        return (
            result,
            cm_fig,
            metrics_df
        )

    except Exception as e:

        return (
            f"❌ Error: {str(e)}",
            None,
            None
        )

