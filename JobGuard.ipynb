def get_dataset_stats():

    if DATASET is None:

        return "No dataset loaded."

    total = len(DATASET)

    scams = int(
        DATASET["target"].sum()
    )

    legitimate = total - scams

    scam_percentage = (
        scams / total * 100
    )

    return f"""
### 📊 Dataset Statistics

**Total Job Postings:** {total:,}

**Legitimate Jobs:** {legitimate:,}

**Potential Scam Jobs:** {scams:,}

**Scam Percentage:** {scam_percentage:.2f}%

**Text Features:** TF-IDF

**ML Algorithm:** Logistic Regression

**N-grams:** Unigrams + Bigrams
"""

