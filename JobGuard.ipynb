# 16. BATCH PREDICTION
# ================================================================

def batch_predict(file):

    if file is None:

        return None, "Please upload a CSV or Excel file."

    try:

        filename = file.name.lower()

        if filename.endswith(".csv"):

            df = pd.read_csv(file.name)

        elif filename.endswith(".xlsx"):

            df = pd.read_excel(file.name)

        else:

            return None, "Only CSV and XLSX files are supported."

        # Find text columns
        _, text_cols = detect_columns(df)

        if not text_cols:

            return None, "Could not find text columns."

        df["JobGuard_Text"] = (
            df[text_cols]
            .fillna("")
            .astype(str)
            .agg(" ".join, axis=1)
            .apply(clean_text)
        )

        vectors = VECTORIZER.transform(
            df["JobGuard_Text"]
        )

        predictions = MODEL.predict(
            vectors
        )

        probabilities = MODEL.predict_proba(
            vectors
        )[:, 1]

        df["JobGuard_Prediction"] = np.where(
            predictions == 1,
            "POTENTIAL SCAM",
            "LIKELY LEGITIMATE"
        )

        df["Scam_Probability"] = (
            probabilities * 100
        ).round(2)

        df["Risk_Level"] = pd.cut(
            probabilities,
            bins=[
                -0.01,
                0.40,
                0.60,
                0.80,
                1.01
            ],
            labels=[
                "LOW",
                "MEDIUM",
                "HIGH",
                "VERY HIGH"
            ]
        )

        output_path = "/content/jobguard_predictions.csv"

        df.to_csv(
            output_path,
            index=False
        )

        scam_count = int(
            (predictions == 1).sum()
        )

        legitimate_count = len(predictions) - scam_count

        summary = f"""
### 📋 Batch Analysis Complete

**Total postings:** {len(predictions):,}

**Likely legitimate:** {legitimate_count:,}

**Potential scams:** {scam_count:,}

**Scam rate:** {scam_count / len(predictions) * 100:.2f}%

The prediction file is ready for download.
"""

        return (
            df.head(100),
            summary
        )

    except Exception as e:

        return None, f"❌ Error: {str(e)}"

# ================================================================
# 17. DOWNLOAD BATCH RESULTS
# ================================================================

def download_predictions():

    path = "/content/jobguard_predictions.csv"

    if os.path.exists(path):

        return path

    return None

