def predict_job(
    title,
    company,
    description,
    location,
    employment_type
):

    if not MODEL_READY:

        return (
            "❌ MODEL NOT READY",
            "Please train the model first.",
            "",
            None
        )

    combined = " ".join([
        str(title),
        str(company),
        str(description),
        str(location),
        str(employment_type)
    ])

    combined = clean_text(combined)

    vector = VECTORIZER.transform(
        [combined]
    )

    prediction = MODEL.predict(vector)[0]

    probability = MODEL.predict_proba(
        vector
    )[0][1]

    # Scam risk
    if probability >= 0.80:

        risk = "🔴 VERY HIGH RISK"

    elif probability >= 0.60:

        risk = "🟠 HIGH RISK"

    elif probability >= 0.40:

        risk = "🟡 MEDIUM RISK"

    else:

        risk = "🟢 LOW RISK"

    if prediction == 1:

        verdict = "🚨 POTENTIAL JOB SCAM"

    else:

        verdict = "✅ LIKELY LEGITIMATE"

    # Suspicious keywords
    suspicious_words = [
        "urgent",
        "guaranteed",
        "guarantee",
        "registration fee",
        "processing fee",
        "security deposit",
        "pay",
        "payment",
        "otp",
        "bank account",
        "bank details",
        "cryptocurrency",
        "crypto",
        "telegram",
        "whatsapp",
        "no interview",
        "no experience",
        "immediate selection",
        "limited positions",
        "send money",
        "personal information"
    ]

    lower_text = combined.lower()

    detected = []

    for word in suspicious_words:

        if word in lower_text:
            detected.append(word)

    if detected:

        indicators = ", ".join(
            detected[:10]
        )

    else:

        indicators = "No obvious scam indicators detected."

    # Explanation
    explanation = f"""
### 🔍 JobGuard Analysis

**Verdict:** {verdict}

**Risk Level:** {risk}

**Estimated Scam Probability:** {probability * 100:.2f}%

**Detected Suspicious Indicators:**
{indicators}

---

### ⚠️ Important

This is an ML-based screening system, not a legal or financial guarantee.

Always independently verify:

- Company website
- Recruiter email address
- Official careers page
- Company LinkedIn page
- Interview process
- Salary claims
- Requests for money
- Requests for OTP/passwords
- Requests for banking credentials
"""

    # Feature contributions
    contributions = []

    try:

        feature_names = VECTORIZER.get_feature_names_out()

        coef = MODEL.coef_[0]

        nonzero = vector.toarray()[0]

        for index in np.where(nonzero > 0)[0]:

            contribution = (
                nonzero[index] * coef[index]
            )

            contributions.append(
                (
                    feature_names[index],
                    contribution
                )
            )

        contributions = sorted(
            contributions,
            key=lambda x: abs(x[1]),
            reverse=True
        )[:10]

    except:

        contributions = []

    feature_text = ""

    if contributions:

        feature_text += "\n### 🧠 Important Model Signals\n\n"

        for feature, value in contributions:

            direction = (
                "🚨 scam signal"
                if value > 0
                else "✅ legitimate signal"
            )

            feature_text += (
                f"- **{feature}** → {direction}\n"
            )

    explanation += feature_text

    # Probability gauge
    fig = go.Figure(
        go.Indicator(
            mode="gauge+number",
            value=probability * 100,
            title={
                "text": "Scam Probability"
            },
            gauge={
                "axis": {
                    "range": [0, 100]
                },
                "bar": {
                    "thickness": 0.6
                },
                "steps": [
                    {
                        "range": [0, 40],
                        "name": "Low"
                    },
                    {
                        "range": [40, 60],
                        "name": "Medium"
                    },
                    {
                        "range": [60, 80],
                        "name": "High"
                    },
                    {
                        "range": [80, 100],
                        "name": "Very High"
                    }
                ]
            }
        )
    )

    return (
        verdict,
        explanation,
        f"{probability * 100:.2f}%",
        fig
    )

