# ================================================================
# 5. TEXT CLEANING
# ================================================================

def clean_text(text):

    if pd.isna(text):
        return ""

    text = str(text).lower()

    # Remove URLs
    text = re.sub(r"http\S+|www\S+", " ", text)

    # Remove email addresses
    text = re.sub(r"\S+@\S+", " ", text)

    # Remove HTML
    text = re.sub(r"<.*?>", " ", text)

    # Replace punctuation with spaces
    text = re.sub(r"[^a-zA-Z0-9\s$]", " ", text)

    # Normalize whitespace
    text = re.sub(r"\s+", " ", text)

    return text.strip()

# ================================================================
# 6. AUTOMATIC COLUMN DETECTION
# ================================================================

def detect_columns(df):

    columns_lower = {str(c).lower(): c for c in df.columns}

    # Target detection
    target_candidates = [
        "fraudulent",
        "fraud",
        "scam",
        "label",
        "target",
        "is_fraud",
        "is_fake",
        "fake",
        "class"
    ]

    target = None

    for candidate in target_candidates:

        if candidate in columns_lower:
            target = columns_lower[candidate]
            break

    # Text columns
    text_candidates = [
        "description",
        "job_description",
        "description_text",
        "title",
        "job_title"
    ]

    text_cols = []

    for candidate in text_candidates:

        if candidate in columns_lower:
            text_cols.append(columns_lower[candidate])

    # If no target found, inspect columns
    if target is None:

        for c in df.columns:

            unique = df[c].dropna().astype(str).str.lower().unique()

            if len(unique) <= 5:

                values = set(unique)

                if (
                    "1" in values or
                    "0" in values or
                    "true" in values or
                    "false" in values or
                    "fraudulent" in values or
                    "legitimate" in values
                ):

                    target = c
                    break

    # If no text columns detected, use object columns
    if not text_cols:

        text_cols = [
            c for c in df.columns
            if df[c].dtype == "object"
        ]

    return target, text_cols

# ================================================================
# 7. TARGET NORMALIZATION
# ================================================================

def normalize_target(series):

    def convert(value):

        if pd.isna(value):
            return np.nan

        value = str(value).strip().lower()

        fake_values = {
            "1",
            "true",
            "yes",
            "fake",
            "fraud",
            "fraudulent",
            "scam",
            "spam"
        }

        real_values = {
            "0",
            "false",
            "no",
            "real",
            "legitimate",
            "genuine",
            "not fraudulent"
        }

        if value in fake_values:
            return 1

        if value in real_values:
            return 0

        try:

            numeric = float(value)

            if numeric in [0, 1]:
                return int(numeric)

        except:
            pass

        return np.nan

    return series.apply(convert)

