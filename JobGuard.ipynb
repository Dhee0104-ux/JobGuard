# 8. TRAIN MODEL
# ================================================================

def train_jobguard(df):

    global MODEL
    global VECTORIZER
    global MODEL_READY
    global DATASET
    global TEST_DATA
    global TEST_PREDICTIONS
    global TEXT_COLUMN
    global TARGET_COLUMN
    global METRICS
    global FEATURE_IMPORTANCE

    working_df = df.copy()

    target, text_cols = detect_columns(working_df)

    if target is None:
        raise ValueError(
            "Could not automatically find the target column. "
            "Your dataset should contain a column such as "
            "'fraudulent', 'fraud', 'scam', 'label' or 'target'."
        )

    if not text_cols:
        raise ValueError(
            "No text columns were found in the dataset."
        )

    TARGET_COLUMN = target

    # Combine all useful text fields
    working_df["combined_text"] = (
        working_df[text_cols]
        .fillna("")
        .astype(str)
        .agg(" ".join, axis=1)
    )

    working_df["combined_text"] = working_df["combined_text"].apply(clean_text)

    # Normalize labels
    working_df["target"] = normalize_target(
        working_df[target]
    )

    # Remove invalid rows
    working_df = working_df.dropna(
        subset=["combined_text", "target"]
    )

    working_df = working_df[
        working_df["combined_text"].str.len() > 5
    ]

    working_df["target"] = working_df["target"].astype(int)

    if working_df["target"].nunique() < 2:

        raise ValueError(
            "The dataset must contain both legitimate and fraudulent job postings."
        )

    # Need enough examples for stratified split
    if len(working_df) < 10:

        raise ValueError(
            "Dataset is too small. Please provide at least 10 job postings."
        )

    DATASET = working_df.copy()

    TEXT_COLUMN = "combined_text"

    X = working_df["combined_text"]
    y = working_df["target"]

    # Train/test split
    X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=0.20,
        random_state=42,
        stratify=y
    )

    # TF-IDF
    VECTORIZER = TfidfVectorizer(
        lowercase=True,
        stop_words="english",
        ngram_range=(1, 2),
        min_df=1,
        max_df=0.95,
        sublinear_tf=True,
        max_features=15000
    )

    X_train_tfidf = VECTORIZER.fit_transform(X_train)
    X_test_tfidf = VECTORIZER.transform(X_test)

    # Logistic Regression
    MODEL = LogisticRegression(
        max_iter=2000,
        class_weight="balanced",
        random_state=42
    )

    MODEL.fit(X_train_tfidf, y_train)

    # Predictions
    y_pred = MODEL.predict(X_test_tfidf)
    y_probability = MODEL.predict_proba(X_test_tfidf)[:, 1]

    # Metrics
    accuracy = accuracy_score(y_test, y_pred)
    precision = precision_score(
        y_test,
        y_pred,
        zero_division=0
    )
    recall = recall_score(
        y_test,
        y_pred,
        zero_division=0
    )
    f1 = f1_score(
        y_test,
        y_pred,
        zero_division=0
    )

    try:
        auc = roc_auc_score(
            y_test,
            y_probability
        )
    except:
        auc = 0

    METRICS = {
        "Accuracy": accuracy,
        "Precision": precision,
        "Recall": recall,
        "F1 Score": f1,
        "ROC AUC": auc
    }

    # Store test predictions
    TEST_DATA = pd.DataFrame({
        "text": X_test.values,
        "actual": y_test.values,
        "predicted": y_pred,
        "scam_probability": y_probability
    })

    TEST_DATA["prediction"] = TEST_DATA["predicted"].map({
        0: "LEGITIMATE",
        1: "POTENTIAL SCAM"
    })

    # Feature importance
    feature_names = VECTORIZER.get_feature_names_out()

    coefficients = MODEL.coef_[0]

    feature_df = pd.DataFrame({
        "feature": feature_names,
        "importance": coefficients
    })

    FEATURE_IMPORTANCE = feature_df.sort_values(
        "importance",
        ascending=False
    )

    MODEL_READY = True

    return METRICS

